#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/remotepc/remotepc /usr/bin/remotepc

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/remotepc.service ]; then
			rm -f /etc/systemd/system/remotepc.service /usr/lib/systemd/system/remotepc.service /usr/lib/systemd/user/remotepc.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/remotepc/files/systemd/remotepc.service /usr/lib/systemd/system/remotepc.service
		# try fix error in Ubuntu 18.04
		# Failed to reload remotepc.service: Unit remotepc.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/remotepc.service:10: Executable path is not absolute: pkill -f "remotepc --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/remotepc.service
		fi
		systemctl daemon-reload
		systemctl enable remotepc
		systemctl start remotepc
	fi
fi
